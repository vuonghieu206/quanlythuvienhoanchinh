@model PaginatedList<Reader>
@{
    ViewData["Title"] = "Quản lý Độc giả";
}

<div class="card mt-3">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h3 class="card-title mb-0">Danh sách độc giả</h3>
        <a asp-action="Create" class="btn btn-success btn-sm"><i class="bi bi-plus-circle"></i> Thêm độc giả</a>
    </div>
    <div class="card-body">
        <form id="filter-form" method="get" action="/DocGia" class="row g-2 mb-3">
            <div class="col-9 col-md-6">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, SĐT hoặc email..." />
            </div>
            <div class="col-3 col-md-2 d-grid">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
            </div>
        </form>
        <div id="list-container" data-url="/DocGia" data-page="@Model.PageIndex">
            <partial name="_Table" model="Model" />
        </div>
    </div>
</div>
