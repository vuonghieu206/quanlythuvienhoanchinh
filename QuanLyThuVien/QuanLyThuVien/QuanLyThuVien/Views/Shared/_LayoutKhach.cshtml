@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var cartCount = Context.Session.GetObject<List<int>>("cart")?.Count ?? 0;
    var returnUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - @L["Thư Viện Trực Tuyến"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        .book-cover { height: 220px; object-fit: cover; }
        .book-cover-placeholder { height: 220px; }
        #toast-box { position: fixed; bottom: 1rem; right: 1rem; z-index: 2000; }
        @@media (max-width: 575.98px) { .book-cover, .book-cover-placeholder { height: 180px; } }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/KhachHang"><i class="bi bi-book-half"></i> @L["Thư Viện Trực Tuyến"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="/KhachHang">@L["Trang chủ"]</a></li>
                        <li class="nav-item">
                            <a class="nav-link" href="/KhachHang/Cart">
                                <i class="bi bi-basket"></i> @L["Giỏ mượn"]
                                <span id="cart-count" class="badge bg-warning text-dark">@cartCount</span>
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <form asp-controller="KhachHang" asp-action="SetLanguage" method="post" class="d-flex gap-1">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" name="culture" value="vi" class="btn btn-sm @(lang == "vi" ? "btn-light" : "btn-outline-light")">VI</button>
                            <button type="submit" name="culture" value="en" class="btn btn-sm @(lang == "en" ? "btn-light" : "btn-outline-light")">EN</button>
                        </form>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm">@L["Vào trang quản trị"]</a>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light btn-sm">@L["Đăng nhập Quản trị"]</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 mb-5 flex-grow-1">
        <main role="main">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 text-center text-muted small">
        &copy; @DateTime.Now.Year - @L["Thư Viện Trực Tuyến"]
    </footer>

    <div id="toast-box"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/list-ajax.js" asp-append-version="true"></script>
    <script src="~/js/khach.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
