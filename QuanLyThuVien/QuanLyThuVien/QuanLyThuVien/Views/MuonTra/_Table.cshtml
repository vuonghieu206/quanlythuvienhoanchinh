@model PaginatedList<BorrowRecord>
@functions {
    static string BadgeClass(string s) => s switch
    {
        BorrowStatus.Pending => "bg-info text-dark",
        BorrowStatus.Borrowing => "bg-warning text-dark",
        BorrowStatus.Returned => "bg-success",
        BorrowStatus.Rejected => "bg-secondary",
        _ => "bg-light text-dark"
    };
}
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>ID</th><th>Tên sách</th><th>Người mượn</th><th>SĐT</th>
                <th>Ngày mượn</th><th>Hạn trả</th><th>Ngày trả</th><th>Trạng thái</th><th style="width:210px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="9" class="text-center py-3">Không có phiếu mượn phù hợp.</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                var overdue = item.Status == BorrowStatus.Borrowing && item.DueDate.HasValue && item.DueDate.Value < DateTime.Now;
                <tr class="@(overdue ? "table-danger" : "")">
                    <td>@item.Id</td>
                    <td>@item.BookName</td>
                    <td>@item.ReaderName</td>
                    <td>@item.ContactPhone</td>
                    <td>@item.BorrowDate.ToString("dd/MM/yyyy")</td>
                    <td>@(item.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>@(item.ReturnDate?.ToString("dd/MM/yyyy") ?? "Chưa trả")</td>
                    <td>
                        <span class="badge @BadgeClass(item.Status)">@item.Status</span>
                        @if (overdue) { <span class="badge bg-danger">Quá hạn</span> }
                    </td>
                    <td>
                        @if (item.Status == BorrowStatus.Pending)
                        {
                            <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button class="btn btn-success btn-sm" title="Duyệt"><i class="bi bi-check-lg"></i></button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Từ chối yêu cầu này?');">
                                <button class="btn btn-secondary btn-sm" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                            </form>
                        }
                        @if (item.Status == BorrowStatus.Borrowing)
                        {
                            <form asp-action="Return" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xác nhận độc giả đã trả sách?');">
                                <button class="btn btn-success btn-sm" title="Nhận trả sách"><i class="bi bi-box-arrow-in-down"></i> Trả</button>
                            </form>
                        }
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil-square"></i></a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa phiếu mượn này?');">
                            <button class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="small text-muted mt-2">Tổng: @Model.TotalItems phiếu</div>
<partial name="_Pager" model="Model" />
