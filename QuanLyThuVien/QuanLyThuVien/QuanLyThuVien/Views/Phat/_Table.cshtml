@model PaginatedList<Penalty>
<div class="table-responsive">
    <table class="table table-striped table-hover mb-0">
        <thead class="table-dark">
            <tr><th>ID</th><th>Độc giả</th><th>Lý do</th><th class="text-end">Số tiền</th><th>Trạng thái</th><th style="width:170px">Thao tác</th></tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="6" class="text-center py-3">Không có dữ liệu.</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.ReaderName</td>
                    <td>@item.Reason</td>
                    <td class="text-end">@item.Amount.ToString("N0")</td>
                    <td><span class="badge @(item.IsPaid ? "bg-success" : "bg-danger")">@(item.IsPaid ? "Đã nộp" : "Chưa nộp")</span></td>
                    <td>
                        <form asp-action="TogglePaid" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-success btn-sm" title="Đổi trạng thái nộp"><i class="bi bi-cash-coin"></i></button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa khoản phạt này?');">
                            <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="small text-muted mt-2">Tổng: @Model.TotalItems khoản phạt</div>
<partial name="_Pager" model="Model" />
