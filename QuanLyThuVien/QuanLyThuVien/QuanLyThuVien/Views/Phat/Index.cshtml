@model PaginatedList<Penalty>
@{
    ViewData["Title"] = "Quản lý Tiền phạt";
    string paid = ViewBag.Paid as string ?? "";
}
<div class="card mt-3">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h3 class="card-title mb-0">Danh sách tiền phạt</h3>
        <a asp-action="Create" class="btn btn-success btn-sm"><i class="bi bi-plus-circle"></i> Thêm mới</a>
    </div>
    <div class="card-body">
        <div class="alert alert-warning py-2">Tổng tiền phạt chưa thu: <strong>@(((decimal)ViewBag.TotalUnpaid).ToString("N0")) đ</strong></div>
        <form id="filter-form" method="get" action="/Phat" class="row g-2 mb-3">
            <div class="col-12 col-md-5">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo độc giả hoặc lý do..." />
            </div>
            <div class="col-9 col-md-3">
                <select name="paid" class="form-select">
                    <option value="" selected="@(paid == "")">-- Tất cả --</option>
                    <option value="no" selected="@(paid == "no")">Chưa nộp</option>
                    <option value="yes" selected="@(paid == "yes")">Đã nộp</option>
                </select>
            </div>
            <div class="col-3 col-md-2 d-grid"><button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button></div>
        </form>
        <div id="list-container" data-url="/Phat" data-page="@Model.PageIndex">
            <partial name="_Table" model="Model" />
        </div>
    </div>
</div>
