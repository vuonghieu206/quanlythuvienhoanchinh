@model PaginatedList<Book>
@{
    Layout = "_LayoutKhach";
    ViewData["Title"] = L["Tra cứu sách"].Value;
    var categories = (List<string>)ViewBag.Categories;
    string sort = ViewBag.Sort as string ?? "";
}

<div class="text-center mb-4">
    <h2 class="text-primary fw-bold">@L["Khám phá kho sách"]</h2>
    <p class="text-muted">@L["Tìm kiếm và tra cứu các đầu sách tại thư viện"]</p>
</div>

<form id="filter-form" method="get" action="/KhachHang" class="row g-2 justify-content-center mb-4">
    <div class="col-12 col-md-5">
        <input type="text" id="search-input" name="search" value="@ViewBag.Search" list="suggest" autocomplete="off"
               class="form-control shadow-sm" placeholder="@L["Nhập tên sách hoặc tác giả..."]" />
        <datalist id="suggest"></datalist>
    </div>
    <div class="col-6 col-md-2">
        <select name="category" class="form-select shadow-sm">
            <option value="">@L["Tất cả thể loại"]</option>
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(c == (string?)ViewBag.Category)">@c</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select name="sort" class="form-select shadow-sm">
            <option value="" selected="@(sort == "")">@L["Tên A → Z"]</option>
            <option value="title_desc" selected="@(sort == "title_desc")">@L["Tên Z → A"]</option>
            <option value="newest" selected="@(sort == "newest")">@L["Mới nhất"]</option>
            <option value="available" selected="@(sort == "available")">@L["Còn nhiều nhất"]</option>
        </select>
    </div>
    <div class="col-12 col-md-2 d-grid">
        <button type="submit" class="btn btn-primary shadow-sm"><i class="bi bi-search"></i> @L["Tìm kiếm"]</button>
    </div>
</form>

<div id="list-container" data-url="/KhachHang" data-page="@Model.PageIndex">
    <partial name="_BookCards" model="Model" />
</div>
